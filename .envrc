# shellcheck shell=bash
# direnv entrypoint: pins every cache/venv/tmp under ./.cache/ (external SSD)
# and installs the repo-local git hooks + contributor identity.
strict_env

CACHE_ROOT="$(expand_path .cache)"

# --- uv / Python -------------------------------------------------------------
export UV_CACHE_DIR="${CACHE_ROOT}/uv"
export UV_PROJECT_ENVIRONMENT="${CACHE_ROOT}/venv"
export UV_PYTHON_INSTALL_DIR="${CACHE_ROOT}/python"
export UV_PYTHON_PREFERENCE="only-managed"
export UV_LINK_MODE="copy"
export PIP_CACHE_DIR="${CACHE_ROOT}/pip"
export PYTHONPYCACHEPREFIX="${CACHE_ROOT}/pycache"

# --- Tooling caches ----------------------------------------------------------
export RUFF_CACHE_DIR="${CACHE_ROOT}/ruff"
export MYPY_CACHE_DIR="${CACHE_ROOT}/mypy"
export COVERAGE_FILE="${CACHE_ROOT}/coverage/.coverage"
export XDG_CACHE_HOME="${CACHE_ROOT}/xdg"
export TMPDIR="${CACHE_ROOT}/tmp"

mkdir -p "$UV_CACHE_DIR" "$UV_PYTHON_INSTALL_DIR" "$PIP_CACHE_DIR" "$PYTHONPYCACHEPREFIX" \
  "$RUFF_CACHE_DIR" "$MYPY_CACHE_DIR" "${CACHE_ROOT}/coverage" "$XDG_CACHE_HOME" "$TMPDIR"

PATH_add "${UV_PROJECT_ENVIRONMENT}/bin"

# --- Git hooks + sole-contributor identity -----------------------------------
git config --local core.hooksPath .githooks
git config --local user.name "mikeZ98"
git config --local user.email "145975972+mikeZ98@users.noreply.github.com"
chmod +x .githooks/pre-commit .githooks/commit-msg .githooks/pre-push scripts/attribution.sh

# --- Local secrets (never committed) -----------------------------------------
dotenv_if_exists .env
source_env_if_exists .envrc.local
