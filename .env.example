# Copy to .env (git-ignored); direnv loads it automatically.
# Providers are enabled only when their key (or local base URL) is set.
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GATEWAY_VLLM_BASE_URL=http://localhost:8000/v1
# GATEWAY_OLLAMA_BASE_URL=http://localhost:11434/v1

# Routing
# GATEWAY_TIER1_PROVIDER=mistral
# GATEWAY_TIER1_MODEL=mistral-small-latest
# GATEWAY_TIER2_MODEL=claude-sonnet-5-5
# GATEWAY_TIER3_MODEL=claude-opus-5-5
# GATEWAY_TIER3_MIN_SCORE=0.8
# GATEWAY_PROVIDER_TIMEOUT_S=60

# Semantic cache (":memory:" = process-local)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# GATEWAY_QDRANT_COLLECTION=semantic_cache
# GATEWAY_SIMILARITY_THRESHOLD=0.95

# Embeddings: "hashing" (offline) or "openai_compatible"
# GATEWAY_EMBEDDING_BACKEND=openai_compatible
# GATEWAY_EMBEDDING_BASE_URL=https://api.mistral.ai/v1
# GATEWAY_EMBEDDING_MODEL=mistral-embed
# GATEWAY_EMBEDDING_DIMENSION=1024
# GATEWAY_EMBEDDING_API_KEY=

# Rate limiting (guardrails step)
REDIS_URL=redis://localhost:6379/0
